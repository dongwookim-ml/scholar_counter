[Unit]
Description=Scholar Citation Tracker
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=YOUR_USERNAME
WorkingDirectory=/path/to/scholar_counter
Environment=PYTHONPATH=/path/to/scholar_counter
Environment=PYTHONUNBUFFERED=1
Environment=SCHOLAR_AUTO_UPDATE=1
Environment=SCHOLAR_UPDATE_HOUR=3
ExecStart=/usr/bin/python3 -m scholar_counter.cli serve
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
