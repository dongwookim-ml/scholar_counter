<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.scholar-citation-tracker</string>
    <key>ProgramArguments</key>
    <array>
        <string>/Users/dongwookim/miniconda3/bin/python3</string>
        <string>-m</string>
        <string>scholar_counter.cli</string>
        <string>serve</string>
    </array>
    <key>WorkingDirectory</key>
    <string>/Users/dongwookim/Workspace/scholar_counter</string>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>StandardOutPath</key>
    <string>/Users/dongwookim/Workspace/scholar_counter/logs/scholar-tracker.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/dongwookim/Workspace/scholar_counter/logs/scholar-tracker-error.log</string>
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/usr/local/bin:/usr/bin:/bin</string>
        <key>PYTHONPATH</key>
        <string>/Users/dongwookim/Workspace/scholar_counter</string>
        <key>PYTHONUNBUFFERED</key>
        <string>1</string>
        <!-- Daily refresh at 03:00 local time. -->
        <key>SCHOLAR_AUTO_UPDATE</key>
        <string>1</string>
        <key>SCHOLAR_UPDATE_HOUR</key>
        <string>3</string>
    </dict>
</dict>
</plist>
